# Phlexed generated files (per-project output)
.phlexed/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# Ruby
*.gem
.bundle
vendor/bundle

# Rails (sample app)
sample/log/*
sample/tmp/*
sample/storage/*
sample/db/*.sqlite3
sample/db/*.sqlite3-*
sample/node_modules/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Ralph backup directories
.ralph_backup_*
