# Phlexed Retrofit — .ralphrc
# Generated by /phlexed-retrofit on {{GENERATED_AT}}
#
# This file configures the Ralph autonomous loop that converts this project's
# ERB/HAML/Slim views to Phlex. Ralph runs one iteration per view, reading
# .phlexed/retrofit/PROMPT.md and updating .phlexed/retrofit/fix_plan.md as
# it makes progress.
#
# To run: ralph -p .phlexed/retrofit/PROMPT.md
#
# To stop: Ctrl-C in the Ralph terminal, or delete fix_plan.md to cancel
# the remaining work. Ralph always commits atomically, so you can stop at
# any iteration boundary without losing work.

# Maximum iterations before Ralph stops automatically. Each iteration converts
# one view. Set this to roughly 1.2x the number of convertible views to leave
# headroom for skip/retry logic. Ralph will stop earlier if fix_plan.md is done.
max_iterations = {{MAX_ITERATIONS}}

# Project root — absolute path for unambiguous resolution.
working_directory = "{{PROJECT_ROOT}}"

# Tool permissions — the minimal set Ralph needs to convert views safely.
# We whitelist specific commands rather than granting broad shell access.
[tools.bash]
allow = [
  # File inspection and diff
  "ls *",
  "cat *",
  "head *",
  "tail *",
  "wc *",
  "diff *",

  # Git — scoped to this retrofit's commits
  "git status",
  "git status --porcelain",
  "git diff *",
  "git diff --cached *",
  "git log *",
  "git log --oneline *",
  "git add *",
  "git commit -m *",
  "git checkout -- *",
  "git restore *",
  "git rev-parse *",
  "git show *",
  "git blame *",

  # Ruby / Bundler
  "bundle exec *",
  "bundle show *",
  "bundle list *",
  "ruby -c *",
  "ruby -Iapp -c *",

  # Rails
  "bin/rails routes *",
  "bin/rails test *",
  "bin/rails runner *",

  # RSpec
  "bundle exec rspec *",
  "bundle exec rspec -f documentation *",

  # Minitest
  "bundle exec rails test *",

  # phlexed tools (for invoking sub-skills + rebuilding registry)
  "phlexed-registry *",
  "phlexed-detect *",

  # File moves — needed to rename templates to .pre-phlex
  "mv app/views/* app/views/*",
  "mv app/components/* app/components/*",

  # Making new directories under app/
  "mkdir -p app/views/*",
  "mkdir -p app/components/*",
  "mkdir -p spec/views/*",
  "mkdir -p spec/components/*",
  "mkdir -p test/views/*",
  "mkdir -p test/components/*"
]

# Explicitly forbidden — even if they'd match an allow pattern above,
# these are blocked. Safety nets.
deny = [
  # Destructive git
  "git reset --hard *",
  "git push *",
  "git push --force *",
  "git clean -fd /*",
  "git checkout main",
  "git checkout master",
  "git rebase *",
  "git stash drop *",

  # Wildcarded deletes
  "rm -rf *",
  "rm -rf /*",
  "rm -rf ~/*",

  # Anything outside the project
  "cd /*",
  "cd ~/*",

  # Network calls
  "curl *",
  "wget *",

  # Shell escapes
  "eval *",
  "exec *",

  # Hook bypasses
  "git commit --no-verify *",
  "git commit --no-gpg-sign *",
  "git push --no-verify *"
]

# File edit permissions. Ralph can freely edit files under these paths.
[tools.edit]
allow = [
  "app/views/**",
  "app/components/**",
  "app/controllers/**",
  "spec/views/**",
  "spec/components/**",
  "spec/system/**",
  "test/views/**",
  "test/components/**",
  "test/system/**",
  ".phlexed/retrofit/fix_plan.md"
]

# Never edit these, even if the allow list would match.
deny = [
  ".phlexed/registry.json",
  ".phlexed/retrofit-audit.json",
  ".phlexed/retrofit-plan.json",
  ".phlexed/retrofit/PROMPT.md",
  ".phlexed/retrofit/.ralphrc",
  "Gemfile",
  "Gemfile.lock",
  "config/database.yml",
  "config/credentials/*",
  ".env*"
]

# Logging — write iteration logs to .phlexed/retrofit/ so the user can
# inspect what Ralph did after the fact.
[logging]
directory = ".phlexed/retrofit/logs"
level = "info"
keep_iterations = 50
